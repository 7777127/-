<script>
/* KYIV Р±РµР·РїРµРєР° вЂ” РЅРѕРІРёРЅРё Р· GitHub */

document.addEventListener("DOMContentLoaded", () => {

    const newsCard =
        document.querySelector(".news-card");

    if (!newsCard) return;


    /* GitHub Raw вЂ” РґР¶РµСЂРµР»Рѕ Р°РІС‚РѕРјР°С‚РёС‡РЅРѕ РѕРЅРѕРІР»РµРЅРёС… РЅРѕРІРёРЅ */
    const NEWS_URL =
        "https://raw.githubusercontent.com/7777127/-/main/news-data.json";


    function escapeHtml(value) {

        return String(value || "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");

    }


    function formatNewsDate(value) {

        if (!value) {
            return "Р§Р°СЃ РЅРµ РІРєР°Р·Р°РЅРѕ";
        }

        const date =
            new Date(value);

        if (isNaN(date.getTime())) {
            return "Р§Р°СЃ РЅРµ РІРєР°Р·Р°РЅРѕ";
        }

        return date.toLocaleString(
            "uk-UA",
            {
                day: "2-digit",
                month: "2-digit",
                hour: "2-digit",
                minute: "2-digit"
            }
        );

    }


    async function loadNews() {

        try {

            const response =
                await fetch(
                    NEWS_URL +
                    "?ts=" +
                    Date.now(),
                    {
                        cache: "no-store"
                    }
                );


            if (!response.ok) {

                throw new Error(
                    "РќРµ РІРґР°Р»РѕСЃСЏ РѕС‚СЂРёРјР°С‚Рё news-data.json"
                );

            }


            const data =
                await response.json();


            if (
                !data ||
                !Array.isArray(data.items)
            ) {

                throw new Error(
                    "РќРµРїСЂР°РІРёР»СЊРЅРёР№ С„РѕСЂРјР°С‚ news-data.json"
                );

            }


            const news =
                data.items;


            /* РЇРєС‰Рѕ РЅРѕРІРёРЅ РїРѕРєРё РЅРµРјР°С” */

            if (!news.length) {

                newsCard.innerHTML = `

                    <div class="news-title">
                        рџ“° РћСЃС‚Р°РЅРЅС– РЅРѕРІРёРЅРё
                    </div>

                    <div class="news-item">

                        <div class="news-time">
                            РћС‡С–РєСѓС”РјРѕ РЅРѕРІС– РїРѕРІС–РґРѕРјР»РµРЅРЅСЏ
                        </div>

                        <div class="news-text">
                            РќРѕРІРёРЅРё РїРѕРєРё РЅРµ РѕС‚СЂРёРјР°РЅС– Р· РѕС„С–С†С–Р№РЅРёС… РґР¶РµСЂРµР».
                        </div>

                    </div>

                `;

                return;

            }


            newsCard.innerHTML = `

                <div class="news-title">
                    рџ“° РћСЃС‚Р°РЅРЅС– РЅРѕРІРёРЅРё
                </div>

                <div class="news-list"></div>

                ${
                    news.length > 3
                    ? `
                        <button
                            type="button"
                            class="news-toggle">
                            РџРѕРєР°Р·Р°С‚Рё РІСЃС– РЅРѕРІРёРЅРё
                        </button>
                      `
                    : ""
                }

            `;


            const newsList =
                newsCard.querySelector(
                    ".news-list"
                );


            const toggleButton =
                newsCard.querySelector(
                    ".news-toggle"
                );


            news.forEach(
                (item, index) => {

                    const newsItem =
                        document.createElement(
                            "div"
                        );


                    newsItem.className =
                        "news-item";


                    /* РџРµСЂС€С– 3 РїРѕРєР°Р·СѓС”РјРѕ РѕРґСЂР°Р·Сѓ */

                    if (index >= 3) {

                        newsItem.classList.add(
                            "news-hidden"
                        );

                    }


                    const title =
                        item.title || "Р‘РµР· Р·Р°РіРѕР»РѕРІРєР°";


                    const source =
                        item.source || "РћС„С–С†С–Р№РЅРµ РґР¶РµСЂРµР»Рѕ";


                    const fullText =
                        item.text ||
                        item.description ||
                        "";


                    const shortText =
                        fullText.length > 180
                        ? fullText
                            .slice(0, 180)
                            .trim() + "вЂ¦"
                        : fullText;


                    newsItem.innerHTML = `

                        <div class="news-time">
                            ${escapeHtml(
                                formatNewsDate(
                                    item.publishedAt
                                )
                            )}
                        </div>

                        <div class="news-source">
                            ${escapeHtml(source)}
                        </div>

                        <div class="news-text">
                            ${escapeHtml(title)}
                        </div>

                        ${
                            fullText
                            ? `

                                <div
                                    class="news-description"
                                    data-full="${encodeURIComponent(fullText)}"
                                    data-short="${encodeURIComponent(shortText)}">

                                    ${escapeHtml(shortText)}

                                </div>

                                ${
                                    fullText.length > 180
                                    ? `

                                        <button
                                            type="button"
                                            class="news-more">
                                            Р§РёС‚Р°С‚Рё РїРѕРІРЅС–СЃС‚СЋ
                                        </button>

                                      `
                                    : ""
                                }

                              `
                            : ""
                        }

                        ${
                            item.url
                            ? `

                                <a
                                    class="news-link"
                                    href="${escapeHtml(item.url)}"
                                    target="_blank"
                                    rel="noopener noreferrer">

                                    Р’С–РґРєСЂРёС‚Рё РґР¶РµСЂРµР»Рѕ

                                </a>

                              `
                            : ""
                        }

                    `;


                    /* РљРЅРѕРїРєР° "Р§РёС‚Р°С‚Рё РїРѕРІРЅС–СЃС‚СЋ" */

                    const moreButton =
                        newsItem.querySelector(
                            ".news-more"
                        );


                    const description =
                        newsItem.querySelector(
                            ".news-description"
                        );


                    if (
                        moreButton &&
                        description
                    ) {

                        moreButton.addEventListener(
                            "click",
                            () => {

                                const expanded =
                                    newsItem.classList.toggle(
                                        "expanded"
                                    );


                                if (expanded) {

                                    description.textContent =
                                        decodeURIComponent(
                                            description.dataset.full
                                        );

                                    moreButton.textContent =
                                        "Р—РіРѕСЂРЅСѓС‚Рё";

                                } else {

                                    description.textContent =
                                        decodeURIComponent(
                                            description.dataset.short
                                        );

                                    moreButton.textContent =
                                        "Р§РёС‚Р°С‚Рё РїРѕРІРЅС–СЃС‚СЋ";

                                }

                            }
                        );

                    }


                    newsList.appendChild(
                        newsItem
                    );

                }
            );


            /* РџРѕРєР°Р·Р°С‚Рё РІСЃС– / Р·РіРѕСЂРЅСѓС‚Рё */

            if (toggleButton) {

                toggleButton.addEventListener(
                    "click",
                    () => {

                        const expanded =
                            newsCard.classList.toggle(
                                "news-expanded"
                            );


                        if (expanded) {

                            toggleButton.textContent =
                                "Р—РіРѕСЂРЅСѓС‚Рё РЅРѕРІРёРЅРё";

                        } else {

                            toggleButton.textContent =
                                "РџРѕРєР°Р·Р°С‚Рё РІСЃС– РЅРѕРІРёРЅРё";

                        }

                    }
                );

            }


        } catch (error) {

            console.error(
                "РџРѕРјРёР»РєР° Р·Р°РІР°РЅС‚Р°Р¶РµРЅРЅСЏ РЅРѕРІРёРЅ:",
                error
            );

        }

    }


    /* РџРµСЂС€Рµ Р·Р°РІР°РЅС‚Р°Р¶РµРЅРЅСЏ */

    loadNews();


    /*
       РџРµСЂРµРІС–СЂСЏС”РјРѕ GitHub РєРѕР¶РЅС– 30 СЃРµРєСѓРЅРґ.

       РЎР°Рј GitHub РѕРЅРѕРІР»СЋС” news-data.json
       РїСЂРёР±Р»РёР·РЅРѕ РєРѕР¶РЅС– 5 С…РІРёР»РёРЅ С‡РµСЂРµР· Actions.
    */

    setInterval(
        loadNews,
        30 * 1000
    );

});
</script>

