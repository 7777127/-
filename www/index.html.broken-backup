  --radius: 20px;
}


/* =================================
   РўР•РњРќРђ РўР•РњРђ
================================= */

body.dark {
  --bg: #0c1016;
  --card: #151a21;
  --card-soft: #1b222b;

  --text: #f3f4f6;
  --text-soft: #d1d5db;
  --muted: #9aa4b2;

  --border: rgba(255, 255, 255, 0.08);

  --primary: #60a5fa;
  --primary-soft: #172554;

  --green: #4ade80;
  --green-soft: #10291b;

  --red: #f87171;
  --red-soft: #35181b;

  --yellow: #fbbf24;
  --yellow-soft: #332711;

