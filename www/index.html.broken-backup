const HISTORY_PREFIX =
  "kyiv-bezpeka-alert-history-";

const HISTORY_DAYS = 7;
const HISTORY_MAX = 200;


/* РћРўР РРњРђРўР РљР›Р®Р§ Р”Р›РЇ Р’РР‘Р РђРќРћР“Рћ РњР†РЎРўРђ */

function getHistoryKey() {

  const city = getSelectedCity();

  return HISTORY_PREFIX + city;

}


/* РћРўР РРњРђРўР Р†РЎРўРћР Р†Р® */

function getAlertHistory() {

  try {

    const saved =
      localStorage.getItem(
        getHistoryKey()
      );

    const parsed =
      saved ? JSON.parse(saved) : [];

    if (!Array.isArray(parsed)) {
      return [];
    }

    const now = Date.now();

    const sevenDays =
      HISTORY_DAYS *
      24 *
      60 *
      60 *
      1000;

    const filtered =
      parsed.filter(item => {

        const dateValue =
          item.endedAt ||
          item.startedAt;

        const time =
          new Date(dateValue).getTime();

        return (
          !isNaN(time) &&
          now - time <= sevenDays
        );

      });

    return filtered;

  } catch (error) {

    console.error(
      "РџРѕРјРёР»РєР° С–СЃС‚РѕСЂС–С—:",
      error
    );

    return [];

  }

}


/* Р—Р‘Р•Р Р•Р“РўР Р†РЎРўРћР Р†Р® */

function saveAlertHistory(history) {

  try {

    localStorage.setItem(

      getHistoryKey(),

      JSON.stringify(
        history
          .slice(0, HISTORY_MAX)
      )

    );

  } catch (error) {

    console.error(
      "РџРѕРјРёР»РєР° Р·Р±РµСЂРµР¶РµРЅРЅСЏ С–СЃС‚РѕСЂС–С—:",
      error
    );

  }

}


