/* Р¤РћР РњРђРўРЈР’РђРќРќРЇ Р”РђРўР */

function formatHistoryDate(value) {

  if (!value) {
    return "вЂ”";
  }

  const date =
    new Date(value);

  if (isNaN(date.getTime())) {
    return "вЂ”";
  }

  return date.toLocaleString(
    "uk-UA",
    {
      day: "2-digit",
      month: "2-digit",
      hour: "2-digit",
      minute: "2-digit"
    }
  );

}


/* РўР РР’РђР›Р†РЎРўР¬ */

function formatHistoryDuration(
  start,
  end
) {

  if (!start || !end) {
    return "";
  }

  const startDate =
    new Date(start);

  const endDate =
    new Date(end);

  if (
    isNaN(startDate.getTime()) ||
    isNaN(endDate.getTime())
  ) {
    return "";
  }

  const totalMinutes =
    Math.max(
      0,
      Math.floor(
        (endDate - startDate) /
        60000
      )
    );

  const hours =
    Math.floor(
      totalMinutes / 60
    );

  const minutes =
    totalMinutes % 60;

  if (hours > 0) {

    return (
      hours +
      " РіРѕРґ " +
      minutes +
      " С…РІ"
    );

  }

  return minutes + " С…РІ";

}


