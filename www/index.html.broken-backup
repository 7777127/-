function formatDuration(startTime) {

  if (!startTime) return "";

  const start = new Date(startTime);
  const now = new Date();

  if (isNaN(start.getTime())) return "";

  const totalMinutes = Math.max(
    0,
    Math.floor((now - start) / 60000)
  );

  const hours =
    Math.floor(totalMinutes / 60);

  const minutes =
    totalMinutes % 60;

  if (hours > 0) {
    return "вЏ±пёЏ РўСЂРёРІР°С”: " +
      hours + " РіРѕРґ " +
      minutes + " С…РІ";
  }

  return "вЏ±пёЏ РўСЂРёРІР°С”: " +
    minutes + " С…РІ";
}

