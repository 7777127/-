<style>
* {
  box-sizing: border-box;
}

:root {
  --bg: #f4f6f9;
  --card: #ffffff;
  --card-soft: #f7f9fc;

  --text: #18202a;
  --text-soft: #3f4854;
  --muted: #707986;

  --border: rgba(20, 30, 40, 0.08);

  --primary: #2563eb;
  --primary-soft: #eff6ff;

  --green: #16a34a;
  --green-soft: #ecfdf3;

  --red: #dc2626;
  --red-soft: #fff1f2;

  --yellow: #d97706;
  --yellow-soft: #fffbeb;

  --shadow:
    0 8px 30px rgba(15, 23, 42, 0.07);

  --shadow-small:
