/* =========================
   DTEK вЂ” Р“Р РђР¤Р†Рљ Р’Р†Р”РљР›Р®Р§Р•РќР¬
   ========================= */

.dtek-card { text-align: center; }
.dtek-card .card-title { font-size: 18px; font-weight: 800; color: var(--text); }
.dtek-location { margin-top: 7px; font-size: 13px; color: var(--muted); }
.dtek-schedule { margin-top: 14px; padding: 14px; border-radius: 16px; background: var(--card-soft); border: 1px solid var(--border); min-height: 90px; box-sizing: border-box; }
.dtek-loading { min-height: 60px; display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 13px; }
.dtek-button { display: block; margin-top: 13px; padding: 12px 14px; border-radius: 13px; background: var(--accent); color: #fff !important; text-decoration: none; font-size: 14px; font-weight: 700; transition: transform .15s ease, opacity .15s ease; }
.dtek-button:active { transform: scale(.98); opacity: .85; }
.dtek-note { margin-top: 9px; font-size: 11px; line-height: 1.4; color: var(--muted); }

.dtek-table-wrapper { width: 100%; overflow-x: auto; overflow-y: hidden; margin-top: 12px; padding-bottom: 4px; -webkit-overflow-scrolling: touch; }
.dtek-table { display: grid; grid-template-columns: repeat(24, minmax(38px, 1fr)); gap: 4px; min-width: 960px; }
.dtek-hour-cell { text-align: center; position: relative; }
.dtek-hour-number { font-size: 10px; font-weight: 700; color: var(--muted); margin-bottom: 4px; }
.dtek-hour-block { height: 34px; width: 100%; border-radius: 8px; border: 1px solid var(--border); box-sizing: border-box; overflow: hidden; transition: transform .15s ease; }
