        const type =
            button.dataset.alertSound;

        setAlertSound(type);

        if (!audioContext) {

            audioContext =
                new (window.AudioContext ||
                    window.webkitAudioContext)();

        }

        if (audioContext.state === "suspended") {
            audioContext.resume();
        }

        if (type === 'drone') {
            playDroneSound();
            alertVibration();
        }

        if (type === 'missile') {
            playMissileSound();
            alertVibration();
        }

        if (type === 'allclear') {
            playAllClearSound();
        }

        if (type === 'test') {
            playTestSound();
            alertVibration();
        }

    });

});
